    {
      "id": "m10-code",
      "name": "Filtrar Prazos 80 e 87 Dias",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ],
      "parameters": {
        "jsCode": "\nconst clientes = $('Buscar Clientes VIP Supabase').all().map(i => i.json);\nconst agora = Date.now();\nconst disparos = [];\n\nfor (const c of clientes) {\n  if (!c.telefone || !c.data_expiracao_vip) continue;\n  const fim = new Date(c.data_expiracao_vip).getTime();\n  const dias = Math.ceil((fim - agora) / (1000 * 60 * 60 * 24));\n  const nome = c.nome_cliente ? c.nome_cliente.split(' ')[0] : 'Guerreiro(a)';\n  const link = c.link_renovacao || 'https://marcaopersonal.com#renovacao-vip';\n\n  if (dias === 10 || dias === 9) {\n    disparos.push({\n      telefone: c.telefone,\n      id: c.id,\n      tipo: 'aviso_10dias',\n      texto: `Fala, ${nome}! 🦁 Marcão na área! Passando pra te dar os parabéns pelo seu foco na balança de bioimpedância!\\n\\nFaltam só 10 dias pra fechar seus 3 meses de acompanhamento gratuito comigo! Como você evoluiu demais, liberei sua assinatura VIP por apenas R$ 19,90 por mês pra você continuar recebendo meus check-ins semanais e ajuste de treino!\\n\\n👉 Mantém seu foco ativo aqui: ${link}`\n    });\n  } else if (dias === 3 || dias === 2) {\n    disparos.push({\n      telefone: c.telefone,\n      id: c.id,\n      tipo: 'aviso_3dias',\n      texto: `E aí, ${nome}! 💪 Faltam só 3 dias pra encerrar seus 3 meses gratuitos da Balança 360°!\\n\\nNão deixa a peteca cair agora que o shape tá encaixando! Garante sua renovação por R$ 19,90/mês aqui: ${link} 👊`\n    });\n  }\n}\n\nreturn disparos.map(d => ({ json: d }));\n"
      }
    },
    {
