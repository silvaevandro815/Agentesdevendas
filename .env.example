# ==============================================================================
# CONFIGURAÇÕES DO CENTRO DE COMANDO DE IA - MARCAO PERSONAL / LOJA IA
# Copie este arquivo para .env no servidor/local e preencha com seus dados reais.
# NUNCA envie o arquivo .env preenchido para o GitHub.
# ==============================================================================

# Domínios e URLs
DOMAIN_ROOT=marcaopersonal.com
DOMAIN_ADMIN=admin.marcaopersonal.com
DOMAIN_N8N=n8n.marcaopersonal.com
DOMAIN_STORE=loja.marcaopersonal.com

# Modelos de Inteligência Artificial (LLMs)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Banco de Dados PostgreSQL com pgvector (Coolify)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=loja_ia
POSTGRES_USER=loja_admin
POSTGRES_PASSWORD=gere_uma_senha_forte_aqui

# Cache & Fila Redis (Coolify)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=gere_uma_senha_redis_aqui

# n8n Automações 24/7 (Coolify)
N8N_ENCRYPTION_KEY=gere_uma_chave_aleatoria_32_chars
N8N_USER_MANAGEMENT_DISABLED=false
WEBHOOK_URL=https://n8n.marcaopersonal.com/

# WhatsApp Cloud API (Atendimento Sofia e Davi)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_VERIFY_TOKEN=defina_um_token_de_verificacao_webhook

# Meta Ads / Instagram Graph API (Campanhas Rui e Publicações Nina)
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
INSTAGRAM_BUSINESS_ID=
FACEBOOK_PAGE_ID=

# TikTok for Business & Content Posting API
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_ADVERTISER_ID=

# Gateway de Pagamento e Checkout
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Logística & Rastreio (Sem estoque / Dropshipping Nacional)
MELHOR_ENVIO_TOKEN=
MELHOR_ENVIO_ENVIRONMENT=sandbox # ou production

# Painel Administrativo de Aprovações (admin.marcaopersonal.com)
ADMIN_SECRET_KEY=chave_secreta_jwt_para_login_admin
ADMIN_PASSWORD=defina_sua_senha_de_acesso
